<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>OTP Verification</title>
  </head>

  <body
    style="
      margin: 0;
      padding: 0;
      background-color: #f4f7fb;
      font-family: Arial, Helvetica, sans-serif;
    "
  >
    <table
      width="100%"
      cellpadding="0"
      cellspacing="0"
      style="background-color: #f4f7fb; padding: 40px 15px"
    >
      <tr>
        <td align="center">
          <table
            width="100%"
            cellpadding="0"
            cellspacing="0"
            style="
              max-width: 500px;
              background: #ffffff;
              border-radius: 12px;
              overflow: hidden;
              box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
            "
          >
            <!-- Header -->
            <tr>
              <td
                align="center"
                style="background: #2563eb; padding: 25px; color: #ffffff"
              >
                <h1 style="margin: 0; font-size: 26px">OTP Verification</h1>
              </td>
            </tr>

            <!-- Content -->
            <tr>
              <td style="padding: 35px 30px; color: #333333">
                <h2 style="margin-top: 0; font-size: 22px">
                  Hello <%= user %> 👋
                </h2>

                <p style="font-size: 16px; line-height: 1.6; color: #555555">
                  Use the following One-Time Password (OTP) to verify your
                  account:
                </p>

                <!-- OTP -->
                <div style="text-align: center; margin: 30px 0">
                  <span
                    style="
                      display: inline-block;
                      background: #eff6ff;
                      color: #2563eb;
                      font-size: 32px;
                      font-weight: bold;
                      letter-spacing: 8px;
                      padding: 15px 25px;
                      border-radius: 8px;
                      border: 1px solid #bfdbfe;
                    "
                  >
                    <%= otp %>
                  </span>
                </div>

                <p
                  style="
                    font-size: 14px;
                    line-height: 1.6;
                    color: #777777;
                    text-align: center;
                  "
                >
                  This OTP will expire in
                  <strong style="color: #dc2626">2 minutes</strong>.
                </p>

                <p style="font-size: 14px; line-height: 1.6; color: #777777">
                  If you did not request this OTP, you can safely ignore this
                  email.
                </p>
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td
                align="center"
                style="
                  background: #f8fafc;
                  padding: 20px;
                  color: #999999;
                  font-size: 12px;
                "
              >
                <p style="margin: 0">© 2026 Your App. All rights reserved.</p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
