model Message {
  id             String      @id @default(uuid())
  conversationId String
  role           MessageRole
  content        String
  citations      String[]
  tokensIn       Int?
  tokensOut      Int?
  costCents      Int?

  createdAt DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}
